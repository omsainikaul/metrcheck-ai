# MetrCheck AI - Environment Configuration Template
# Copy this file to .env and fill in real values.
# IMPORTANT: Never put real credentials, passwords, or API keys in this file.
# This file is safe to commit — it contains only placeholder values.

# OCR Engine: 'paddleocr' (sole supported engine — PP-OCRv4 deep learning)
OCR_ENGINE=paddleocr

# Environment & Demo Mode
# Use 'development' for local/SIH demo, 'production' for deployment
ENVIRONMENT=development
METRCHECK_DEMO_MODE=true

# Secret key for token signing — MUST be changed to a long random string in production
SECRET_KEY=metrcheck-dev-secret-change-in-prod

# Optional: LLM API Key for enhanced extraction
# Leave empty to use local regex-based extraction
LLM_API_KEY=

# Upload directory for product images
UPLOAD_DIR=./uploads

# SQLite database path
DATABASE_PATH=./metrc_check.db

# Maximum file upload size in MB
MAX_FILE_SIZE_MB=10

# CORS origins (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Font size calibration for Rule 12 (px -> mm conversion factor)
# 0.18 ≈ 300 DPI print scanned at ~141 DPI effective; for 300 DPI scans use 0.0847
FONT_PX_TO_MM_FACTOR=0.18
# OCR Image DPI (when set > 0, factor is auto-derived as 25.4 / OCR_IMAGE_DPI)
OCR_IMAGE_DPI=

# SMTP Configuration (for officer invitation emails)
# Inject these via environment variables or a secrets manager — do NOT hardcode real values here.
METRCHECK_SMTP_HOST=smtp.gmail.com
METRCHECK_SMTP_PORT=587
METRCHECK_SMTP_USER=
METRCHECK_SMTP_PASS=
METRCHECK_SMTP_FROM=
METRCHECK_SMTP_TLS=true
METRCHECK_FRONTEND_URL=http://localhost:5173

# External API integrations (optional — system uses fallback validation when disabled)
FSSAI_API_ENABLED=false
FSSAI_API_URL=
FSSAI_API_KEY=
GS1_API_ENABLED=false
GS1_API_URL=
GS1_API_KEY=

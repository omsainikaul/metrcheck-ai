# MetrCheck AI — Backend Environment Configuration Template
# Copy this file to .env and fill in real values.
# IMPORTANT: Never put real credentials in this file.
# backend/.env is gitignored — do NOT commit it.

# OCR Engine: 'paddleocr' (sole supported engine)
OCR_ENGINE=paddleocr

# Environment & Demonstration Mode Settings:
# For local development / SIH presentation:
ENVIRONMENT=development
METRCHECK_DEMO_MODE=true
SECRET_KEY=metrcheck-dev-secret-change-in-prod

# For production deployment:
# ENVIRONMENT=production
# METRCHECK_DEMO_MODE=false
# SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_MIN_32_CHARS

# Optional: LLM API Key for enhanced extraction
# Leave empty to use local regex-based extraction
LLM_API_KEY=

# Upload directory for product images
UPLOAD_DIR=./uploads

# SQLite database path
DATABASE_PATH=./metrc_check.db

# Maximum file upload size in MB
MAX_FILE_SIZE_MB=10

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=8000

# Font size calibration for Rule 12 (px -> mm conversion factor)
# 0.18 ≈ 300 DPI print scanned at ~141 dpi effective; for 300 DPI scans use 0.0847
FONT_PX_TO_MM_FACTOR=0.18
# OCR Image DPI (when set > 0, factor is auto-derived as 25.4 / OCR_IMAGE_DPI)
OCR_IMAGE_DPI=

# SMTP Configuration — inject via environment variables or secrets manager.
# DO NOT put real email credentials in this file.
METRCHECK_SMTP_HOST=smtp.gmail.com
METRCHECK_SMTP_PORT=587
METRCHECK_SMTP_USER=
METRCHECK_SMTP_PASS=
METRCHECK_SMTP_FROM=
METRCHECK_SMTP_TLS=true
METRCHECK_FRONTEND_URL=http://localhost:5173
